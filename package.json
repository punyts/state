{
    "name": "@punyts/state",
    "version": "1.0.0",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "description": "A state management system",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "clean": "tsc -b tsconfig.json --clean && node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('tsconfig.build.tsbuildinfo',{force:true});}catch{}\"",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "build": "npm run typecheck && tsc -b tsconfig.build.json",
        "test": "npm run test:run",
        "test:run": "vitest run",
        "test:watch": "vitest --watch",
        "test:cov": "vitest run --coverage",
        "build:watch": "tsc -d tsconfig.build.json -w",
        "dev": "npm run build:watch"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@punyts/core": "^1.0.0",
        "test": "^3.3.0"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}